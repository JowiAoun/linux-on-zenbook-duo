#!/usr/bin/env python3
"""duo: the front door of linux-on-zenbook-duo.

    duo <command> [args]   runs `duo-cli <command> [args]`, the bash CLI next to
                           this file (every command `duo` ever had still works)
    duo                    the CLI's usage, until the screen lands here
"""

import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
CLI = os.path.join(HERE, "duo-cli")


def main(argv):
    args = argv or ["help"]
    os.execv(CLI, [CLI] + args)


if __name__ == "__main__":
    main(sys.argv[1:])
