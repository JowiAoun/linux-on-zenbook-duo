#!/usr/bin/env bash
# duo — the CLI of linux-on-zenbook-duo, for the ASUS Zenbook Duo (2024) UX8406MA.
#
# Read-only anywhere (incl. a live USB):  doctor, status, features, config,
#                                         fn-probe, fn-map, report, log, version
# Needs a GNOME session:                  top/bottom/both/toggle, watch-displays,
#                                         set-tablet-mapping, watch-rotation
# May need the root helper / udev rule:   sync-backlight, kb-backlight, bat-limit
#
# Design (docs/DESIGN.md): fail-safe (never zero panels), native-first with
# userspace fallback, poll-don't-storm (1 Hz + debounce), Mutter D-Bus only.
set -euo pipefail

DUO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
LIB="$DUO_ROOT/lib"
TAG=zenduo

# shellcheck source=../lib/conf.sh
source "$LIB/conf.sh"
export ZENDUO_CONF_EXAMPLE="${ZENDUO_CONF_EXAMPLE:-$DUO_ROOT/config/zenduo.conf.example}"

# displayctl.py / set-tablet-mapping need PyGObject (apt python3-gi). A Nix or
# pyenv python3 on the user's PATH does NOT have it, so pin the system
# interpreter for the gi-using scripts. The stdlib-only tools (kb_*, fn_*,
# watch_*, speaker_dsp) use plain python3 and work with either. Override with
# DUO_PYGI if python3-gi lives elsewhere (the Nix package sets it).
PYGI="${DUO_PYGI:-/usr/bin/python3}"

# Knobs from ~/.config/zenduo/zenduo.conf, handed to the daemons as environment.
# A value already in the environment wins (the home-manager units set it).
export ZENDUO_APPLY_METHOD="${ZENDUO_APPLY_METHOD:-$(conf_get APPLY_METHOD)}"
export ZENDUO_DOCK_POLICY="${ZENDUO_DOCK_POLICY:-$(conf_get DOCK_POLICY)}"
export ZENDUO_KB_BACKLIGHT_RESTORE="${ZENDUO_KB_BACKLIGHT_RESTORE:-$(conf_get KB_BACKLIGHT_RESTORE)}"

KBD_VID=0b05
KBD_PID=1b2c
TOP_PANEL=eDP-1
BOTTOM_PANEL=eDP-2
NATIVE_LED=/sys/class/leds/asus::kbd_backlight
HELPER=/usr/local/sbin/zenduo-helper

USER_FEATURES="watch-displays watch-fn watch-backlight watch-rotation bat-limit"

log() { printf '[%s] %s\n' "$TAG" "$*"; logger -t "$TAG" -- "$*" 2>/dev/null || true; }

usage() {
  cat <<'USAGE'
usage: duo <command>

  doctor                 full read-only hardware/health probe (live-USB safe)
  status                 quick glance: panels, keyboard, backlight, battery limit
  features               every feature with its installed/enabled/running state
  enable <feature>       turn a feature on (and start it now)
  disable <feature>      turn a feature off (and stop it now)
  config [get K|set K V] effective settings from ~/.config/zenduo/zenduo.conf
  top|bottom|both        enable that panel set (refuses all-off; pauses the
                         dock policy until the keyboard docks/undocks)
  toggle                 bottom panel on <-> off
  watch-displays         daemon: bottom panel off while the keyboard is docked,
                         back on when it comes off. Nothing else is touched.
  apply-displays         enforce that policy once now (drops any manual override)
  sync-backlight [src [dst]]   copy panel backlight percentage src -> dst
  watch-backlight [src [dst]]  daemon: keep dst backlight synced to src
  kb-init                switch the keyboard into hotkey mode (enables Fn/media keys)
  watch-fn               daemon: init keyboard on connect + act on media keys
  kb-backlight <0-3>     keyboard backlight (native LED if present, else HID);
                         the level is remembered and restored on dock/undock/resume
  kb-backlight --show    print the remembered level
  bat-limit [20-100]     battery charge-limit threshold (no value = BATTERY_LIMIT
                         from the config file)
  speaker-dsp <install|status|uninstall|seed|preset>
                         EasyEffects voicing chain for the built-in speakers
  set-tablet-mapping     map each touchscreen to its own panel (GNOME 46+)
  watch-rotation         daemon: follow accelerometer orientation (EXPERIMENTAL)
  fn-probe               interactively inventory what the Fn keys emit
  fn-map [--show]        guided wizard: press each Fn key -> build a key map (--show: print it)
  watch-input            (root) decode key events from the keyboard + Asus WMI hotkeys
  report                 bundle doctor + status + journal excerpts for a bug report
  log                    follow zenduo journal messages
  version                print the installed version
USAGE
  exit 64
}

# ── shared probes ────────────────────────────────────────────────────────────

kb_attached() {
  local d
  for d in /sys/bus/usb/devices/*/idVendor; do
    [ -r "$d" ] || continue
    if [ "$(cat "$d" 2>/dev/null)" = "$KBD_VID" ] \
       && [ "$(cat "${d%idVendor}idProduct" 2>/dev/null)" = "$KBD_PID" ]; then
      return 0
    fi
  done
  return 1
}

panel_status() { # <connector-suffix like eDP-1> -> "connected"/"disconnected"/absent
  local f
  for f in /sys/class/drm/card*-"$1"/status; do
    [ -r "$f" ] && { cat "$f"; return 0; }
  done
  echo absent
}

panel_enabled() {
  local f
  for f in /sys/class/drm/card*-"$1"/enabled; do
    [ -r "$f" ] && { cat "$f"; return 0; }
  done
  echo absent
}

backlight_devices() { ls /sys/class/backlight 2>/dev/null || true; }

backlight_pct_num() { # <device> -> integer 0-100 (clamped) for machine use
  local base="/sys/class/backlight/$1" cur max pct
  cur="$(cat "$base/brightness" 2>/dev/null)" || return 1
  max="$(cat "$base/max_brightness" 2>/dev/null)" || return 1
  case "$cur$max" in *[!0-9]*) return 1 ;; esac
  [ "$max" -gt 0 ] || return 1
  pct=$(( cur * 100 / max ))
  [ "$pct" -gt 100 ] && pct=100
  echo "$pct"
}

backlight_pct() { # <device> -> "NN%" or "cur/max raw" when values are implausible
  local base="/sys/class/backlight/$1" cur max pct
  cur="$(cat "$base/brightness" 2>/dev/null)" || return 1
  max="$(cat "$base/max_brightness" 2>/dev/null)" || return 1
  case "$cur$max" in *[!0-9]*) echo "?"; return 0 ;; esac
  [ "$max" -gt 0 ] || { echo "?"; return 0; }
  pct=$(( cur * 100 / max ))
  # Some devices (seen: asus_screenpad on the UX8406MA) report brightness
  # beyond max_brightness — show raw values instead of a nonsense percent.
  if [ "$pct" -gt 100 ]; then
    echo "${cur}/${max} raw"
  else
    echo "${pct}%"
  fi
}

override_active() { # -> prints the overriding connectors, or nothing
  local f="${XDG_RUNTIME_DIR:-/tmp/zenduo-$(id -u)}/zenduo/display-override.json"
  [ -r "$f" ] || return 1
  python3 -c 'import json,sys
try:
    doc = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)
print(("docked" if doc.get("docked") else "undocked") + ": " + ", ".join(doc.get("want", [])))' "$f" 2>/dev/null
}

have_user_systemd() { systemctl --user show-environment >/dev/null 2>&1; }

unit_state() { # <feature> -> "installed enabled active" words, or "absent"
  local unit="duo-$1.service" out=""
  have_user_systemd || { echo "no-systemd"; return 0; }
  if systemctl --user cat "$unit" >/dev/null 2>&1; then
    out="installed"
    case "$(systemctl --user is-enabled "$unit" 2>/dev/null || true)" in
      enabled|static) out="$out enabled" ;;
      *) out="$out disabled" ;;
    esac
    if systemctl --user is-active --quiet "$unit" 2>/dev/null; then
      out="$out active"
    elif [ "$(systemctl --user show "$unit" -p Type --value 2>/dev/null)" = oneshot ]; then
      # A oneshot is "inactive" the moment it has finished; say how it went.
      out="$out ran:$(systemctl --user show "$unit" -p Result --value 2>/dev/null || echo '?')"
    else
      out="$out inactive"
    fi
    echo "$out"
  else
    echo "absent"
  fi
}

unit_is_hm_managed() { # <feature>
  local f="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/duo-$1.service"
  [ -L "$f" ] && case "$(readlink -f "$f")" in /nix/store/*) return 0 ;; esac
  return 1
}

# ── doctor ───────────────────────────────────────────────────────────────────

D_PASS=0 D_WARN=0 D_FAIL=0 D_MUSTFAIL=0
ck() { # <PASS|WARN|FAIL|INFO> <must?0/1> <message>
  local verdict="$1" must="$2"; shift 2
  case "$verdict" in
    PASS) D_PASS=$((D_PASS+1)); printf '  [ OK ] %s\n' "$*" ;;
    WARN) D_WARN=$((D_WARN+1)); printf '  [WARN] %s\n' "$*" ;;
    INFO)                       printf '  [info] %s\n' "$*" ;;
    FAIL)
      D_FAIL=$((D_FAIL+1))
      if [ "$must" = 1 ]; then D_MUSTFAIL=$((D_MUSTFAIL+1)); printf '  [FAIL/MUST] %s\n' "$*"
      else printf '  [FAIL] %s\n' "$*"; fi
      ;;
  esac
}

cmd_doctor() {
  echo "== zenduo doctor $(cat "$DUO_ROOT/VERSION" 2>/dev/null || echo dev) — $(date -u +%FT%TZ) =="
  echo
  echo "-- system --"
  ck INFO 0 "kernel: $(uname -r)"
  if [ -r /etc/os-release ]; then
    . /etc/os-release
    ck INFO 0 "distro: ${PRETTY_NAME:-unknown}"
  fi
  local model
  model="$(cat /sys/class/dmi/id/product_name 2>/dev/null || echo unknown)"
  case "$model" in
    *UX8406MA*) ck PASS 0 "model: $model (the machine this project targets)" ;;
    *UX8406*)   ck WARN 0 "model: $model — a Duo variant; most of this applies, report what does not" ;;
    *)          ck WARN 0 "model: $model — not a Zenbook Duo; only the read-only probes mean anything here" ;;
  esac
  ck INFO 0 "session: type=${XDG_SESSION_TYPE:-unset} desktop=${XDG_CURRENT_DESKTOP:-unset}"
  if command -v gnome-shell >/dev/null 2>&1; then
    ck INFO 0 "$(gnome-shell --version 2>/dev/null || echo 'GNOME Shell version unavailable')"
  else
    ck WARN 0 "no gnome-shell — display control needs GNOME/Mutter (see docs/PLAN.md for other desktops)"
  fi
  if grep -q 'i915.enable_psr=0' /proc/cmdline 2>/dev/null; then
    ck PASS 0 "cmdline has i915.enable_psr=0 (OLED flicker fix)"
  else
    ck INFO 0 "cmdline lacks i915.enable_psr=0 (expected before the install; watch for OLED flicker)"
  fi
  if command -v mokutil >/dev/null 2>&1; then
    ck INFO 0 "secure boot: $({ mokutil --sb-state 2>/dev/null || echo unknown; } | tr '\n' ' ')"
  fi
  local kver kmaj krest kmin
  kver="$(uname -r | cut -d- -f1)"; kmaj="${kver%%.*}"; krest="${kver#*.}"; kmin="${krest%%.*}"
  if [ "${kmaj:-0}" -lt 6 ] || { [ "${kmaj:-0}" -eq 6 ] && [ "${kmin:-0}" -lt 11 ]; }; then
    ck WARN 0 "kernel $kver < 6.11 — detaching the keyboard will drop Wi-Fi (asus-wmi quirk landed in 6.11, V6)"
  else
    ck PASS 0 "kernel $kver >= 6.11 — keyboard detach keeps Wi-Fi (V6)"
  fi

  echo
  echo "-- storage (V16) --"
  local nvme_names="" d
  for d in /sys/block/nvme*; do
    [ -e "$d" ] && nvme_names="$nvme_names$(basename "$d") "
  done
  if [ -n "$nvme_names" ]; then
    ck PASS 1 "NVMe visible: $nvme_names"
  else
    ck FAIL 1 "no NVMe device visible — check BIOS VMD/RST (LOOK, don't toggle: docs/HARDWARE.md V16)"
  fi
  # Captured, then matched. `lspci | grep -qi ...` under this script's pipefail
  # can return 141: grep exits at the first match and lspci takes SIGPIPE on the
  # rest of its output, turning a successful match into a reported failure.
  local vmd_out=""
  if command -v lspci >/dev/null 2>&1; then
    vmd_out="$(lspci 2>/dev/null || true)"
  fi
  if grep -qi 'volume management device' <<<"$vmd_out"; then
    ck INFO 0 "Intel VMD controller present (NVMe is behind VMD; fine if the disk is visible)"
  fi

  echo
  echo "-- graphics & panels (V9/V10) --"
  local gpu_found=0
  for d in /sys/bus/pci/devices/*; do
    if [ "$(cat "$d/vendor" 2>/dev/null)" = 0x8086 ] && [ "$(cat "$d/device" 2>/dev/null)" = 0x7d55 ]; then
      gpu_found=1
      ck PASS 0 "iGPU 8086:7d55 (Meteor Lake Arc) present, driver: $(basename "$(readlink -f "$d/driver" 2>/dev/null)" 2>/dev/null || echo none)"
    fi
  done
  [ "$gpu_found" = 1 ] || ck WARN 0 "iGPU 8086:7d55 not found — different SKU? (doctor expects the UX8406MA)"
  local p st en connected=0
  for p in "$TOP_PANEL" "$BOTTOM_PANEL"; do
    st="$(panel_status "$p")"; en="$(panel_enabled "$p")"
    if [ "$st" = connected ]; then
      connected=$((connected+1))
      ck PASS 0 "panel $p: connected (enabled: $en)"
    else
      ck FAIL 1 "panel $p: $st — the i915 second-screen problem? (docs/HARDWARE.md V9)"
    fi
  done
  [ "$connected" = 2 ] && ck PASS 1 "both internal panels detected"
  # The layout the machine has vs the one the dock policy asks for. A mismatch
  # here is the "bottom screen still lit under a docked keyboard" symptom.
  if [ "$(panel_enabled "$BOTTOM_PANEL")" = enabled ] && kb_attached; then
    if override_active >/dev/null; then
      ck INFO 0 "bottom panel on with the keyboard docked — a manual layout is pausing the dock policy ('duo apply-displays' resumes it)"
    else
      ck WARN 0 "bottom panel is ON with the keyboard docked — dock policy not enforced; is duo-watch-displays running? ('duo apply-displays' fixes it now)"
    fi
  fi
  local b
  for b in $(backlight_devices); do
    ck INFO 0 "backlight device: $b ($(backlight_pct "$b" || echo '?'))"
  done

  echo
  echo "-- GNOME / Mutter --"
  if command -v gdbus >/dev/null 2>&1 && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}${XDG_RUNTIME_DIR:-}" ]; then
    if gdbus call --session --dest org.gnome.Mutter.DisplayConfig \
         --object-path /org/gnome/Mutter/DisplayConfig \
         --method org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1; then
      ck PASS 0 "Mutter DisplayConfig reachable on the session bus"
    else
      ck WARN 0 "Mutter DisplayConfig NOT reachable (not in a GNOME session?) — display commands won't work here"
    fi
  else
    ck WARN 0 "no session bus/gdbus — skipping Mutter check (TTY?)"
  fi
  if [ -x "$PYGI" ] && "$PYGI" -c 'import gi' >/dev/null 2>&1; then
    ck PASS 0 "PyGObject importable by $PYGI"
  else
    ck WARN 0 "PyGObject missing for $PYGI — install python3-gi (sudo ./install.sh --system does)"
  fi

  echo
  echo "-- keyboard (V8/V10) --"
  if kb_attached; then
    ck PASS 0 "keyboard $KBD_VID:$KBD_PID attached via USB (pogo)"
    if [ -d /sys/module/hid_asus ]; then
      ck PASS 0 "hid_asus module loaded"
    else
      ck WARN 0 "hid_asus not bound to $KBD_VID:$KBD_PID — typing works via hid-generic; the media/Fn-row keys need 'duo watch-fn' (mainline has no entry for this device, V8)"
    fi
  else
    ck INFO 0 "keyboard not attached via USB right now (detached/BT is fine — re-run attached for full coverage)"
  fi
  if [ -d "$NATIVE_LED" ]; then
    ck PASS 0 "NATIVE kbd-backlight LED present ($NATIVE_LED) — kernel support has landed! (V8 ground truth)"
  else
    ck INFO 0 "no native kbd-backlight LED (expected on current kernels, V8) — 'duo kb-backlight' uses the HID fallback"
  fi
  local u hid_found=0
  for u in /sys/class/hidraw/hidraw*/device/uevent; do
    [ -r "$u" ] || continue
    if grep -qi "0000${KBD_VID}:0000${KBD_PID}" "$u" 2>/dev/null; then
      hid_found=1
      local node
      node="/dev/$(echo "$u" | cut -d/ -f5)"
      if [ -w "$node" ]; then
        ck PASS 0 "hidraw node $node present and writable (udev rule active)"
      else
        ck INFO 0 "hidraw node $node present, not writable by this user (the udev rule installs with 'sudo ./install.sh --system')"
      fi
    fi
  done
  if kb_attached && [ "$hid_found" = 0 ]; then
    ck WARN 0 "keyboard attached but no matching hidraw node — HID backlight fallback unavailable"
  fi

  echo
  echo "-- touch digitizers (V7/V10) --"
  if [ -r /proc/bus/input/devices ]; then
    if grep -qi 'Vendor=04f3 Product=4259' /proc/bus/input/devices; then
      ck PASS 0 "top digitizer ELAN9008 04f3:4259 present"
    else
      ck WARN 0 "top digitizer 04f3:4259 not found"
    fi
    if grep -qi 'Vendor=04f3 Product=42ec' /proc/bus/input/devices; then
      ck PASS 0 "bottom digitizer ELAN9009 04f3:42ec present"
    else
      ck WARN 0 "bottom digitizer 04f3:42ec not found"
    fi
  else
    ck WARN 0 "/proc/bus/input/devices unreadable — skipping digitizer check"
  fi

  echo
  echo "-- sensors --"
  local iio_count
  iio_count="$(ls -d /sys/bus/iio/devices/iio:device* 2>/dev/null | wc -l || true)"
  if [ "$iio_count" -gt 0 ]; then
    ck PASS 0 "IIO sensors: $iio_count device(s)"
  else
    ck WARN 0 "no IIO sensors visible — auto-rotation won't work"
  fi
  if command -v systemctl >/dev/null 2>&1; then
    ck INFO 0 "iio-sensor-proxy: $(systemctl is-active iio-sensor-proxy 2>/dev/null || echo not-found)"
  fi

  echo
  echo "-- audio (V11) --"
  if [ -r /proc/asound/cards ] && grep -q '\[' /proc/asound/cards 2>/dev/null; then
    ck PASS 0 "sound card(s): $(grep '\[' /proc/asound/cards | tr -s ' ' | tr '\n' ';')"
    if grep -qi sof /proc/asound/cards; then
      ck PASS 0 "Intel SOF driver active"
    else
      ck WARN 0 "no SOF card — speakers may be 'dummy output' (V11)"
    fi
  else
    ck FAIL 0 "no sound cards registered — 'dummy output' likely (V11: firmware-sof-signed + kernel)"
  fi
  if [ -x /usr/local/sbin/duo-cs35l41-check ]; then
    if /usr/local/sbin/duo-cs35l41-check >/dev/null 2>&1; then
      ck PASS 0 "CS35L41 speaker amps powered up cleanly this boot"
    else
      ck WARN 0 "CS35L41 amps FAILED their power-up handshake this boot — sound is unprotected/distorted; full power-off fixes it (see docs/HARDWARE.md)"
    fi
  fi

  echo
  echo "-- network (V15) --"
  local wifi_id=""
  if command -v lspci >/dev/null 2>&1; then
    wifi_id="$(lspci -nn 2>/dev/null | grep -i 'network controller' || true)"
  fi
  if [ -n "$wifi_id" ]; then
    ck INFO 0 "wifi: $wifi_id"
    case "$wifi_id" in
      *AX211*|*51f1*) ck PASS 0 "Intel AX211 — well supported" ;;
      *BE200*|*272b*) ck WARN 0 "Intel BE200 — watch for post-suspend drops (docs/HARDWARE.md V15)" ;;
    esac
  else
    ck INFO 0 "wifi card id unavailable (lspci missing?); interfaces: $(ls /sys/class/net 2>/dev/null | tr '\n' ' ')"
  fi

  echo
  echo "-- power (V12/V13) --"
  local bat_found=0 f
  for f in /sys/class/power_supply/BAT*/charge_control_end_threshold; do
    [ -e "$f" ] || continue
    bat_found=1
    ck PASS 0 "battery charge-limit node: $f (current: $(cat "$f" 2>/dev/null)%)"
  done
  [ "$bat_found" = 1 ] || ck WARN 0 "no charge_control_end_threshold — asus-wmi not active? 'duo bat-limit' unavailable"
  if [ -r /sys/firmware/acpi/platform_profile ]; then
    ck INFO 0 "platform_profile: $(cat /sys/firmware/acpi/platform_profile) (choices: $(cat /sys/firmware/acpi/platform_profile_choices 2>/dev/null || echo '?'))"
  else
    ck INFO 0 "no platform_profile node (thermal profiles unavailable)"
  fi
  if [ -r /sys/power/mem_sleep ]; then
    ck INFO 0 "mem_sleep: $(cat /sys/power/mem_sleep) (s2idle-only expected, V13)"
  fi

  echo
  echo "-- install state --"
  local bin
  bin="$(command -v duo 2>/dev/null || true)"
  if [ -n "$bin" ]; then
    ck INFO 0 "duo on PATH: $bin -> $(readlink -f "$bin")"
  else
    ck INFO 0 "duo is not on PATH (running from $DUO_ROOT)"
  fi
  if [ -x "$HELPER" ]; then ck PASS 0 "root helper installed: $HELPER"; else ck INFO 0 "root helper not installed (sync-backlight / bat-limit need it: sudo ./install.sh --system)"; fi
  if [ -r /etc/sudoers.d/zenduo ] 2>/dev/null || sudo -n -l "$HELPER" >/dev/null 2>&1; then
    if sudo -n -l "$HELPER" >/dev/null 2>&1; then ck PASS 0 "sudoers rule grants $HELPER to $USER"; else ck INFO 0 "sudoers rule present but not for $USER"; fi
  else
    ck INFO 0 "no sudoers rule for the helper"
  fi
  if [ -e /etc/udev/rules.d/70-zenduo.rules ]; then ck PASS 0 "udev rule installed"; else ck INFO 0 "udev rule not installed"; fi
  if [ -e /etc/libinput/local-overrides.quirks ]; then ck PASS 0 "libinput palm-rejection quirk installed"; else ck INFO 0 "libinput palm-rejection quirk not installed"; fi
  ck INFO 0 "config: $(conf_path) ($([ -r "$(conf_path)" ] && echo present || echo 'absent, defaults apply'))"
  if have_user_systemd; then
    for f in $USER_FEATURES; do
      ck INFO 0 "feature $f: $(unit_state "$f")$(unit_is_hm_managed "$f" && echo ' (home-manager)')"
    done
  else
    ck INFO 0 "no user systemd session — daemon state unknown from here"
  fi

  echo
  echo "-- kernel log scan --"
  if dmesg >/dev/null 2>&1; then
    local bad
    bad="$(dmesg 2>/dev/null | grep -iE '(i915|asus|sof|cs35l41).*(error|fail|timeout)' | tail -n 5 || true)"
    if [ -n "$bad" ]; then
      ck WARN 0 "suspicious dmesg lines (last 5):"
      printf '%s\n' "$bad" | sed 's/^/         /'
    else
      ck PASS 0 "no i915/asus/sof/cs35l41 errors in dmesg"
    fi
  else
    ck INFO 0 "dmesg not readable as this user — re-run with sudo for the log scan"
  fi

  echo
  echo "== summary: $D_PASS ok, $D_WARN warnings, $D_FAIL failures ($D_MUSTFAIL gate-critical) =="
  if [ "$D_MUSTFAIL" -gt 0 ]; then
    echo "== GATE: NO-GO — a MUST check failed. On a live USB: do not modify the disk. =="
    return 1
  fi
  echo "== GATE: no MUST failures. =="
}

# ── backlight sync ───────────────────────────────────────────────────────────

guess_backlights() { # sets SRC_BL and DST_BL
  SRC_BL="${1:-$(conf_get BACKLIGHT_SOURCE)}"
  DST_BL="${2:-$(conf_get BACKLIGHT_TARGET)}"
  if [ -z "$DST_BL" ]; then
    local d
    # Prefer the bottom panel's native DRM backlight (card*-eDP-2-backlight).
    # Other devices (e.g. asus_screenpad) report a brightness that does NOT
    # track what's on screen, so syncing to them changes nothing visible.
    for d in $(backlight_devices); do
      case "$d" in
        *eDP-2*|*edp-2*)
          # Never pick the source as its own destination.
          if [ "$d" != "$SRC_BL" ]; then DST_BL="$d"; break; fi
          ;;
      esac
    done
    # Fall back to the first non-source device if there's no eDP-2 backlight.
    if [ -z "$DST_BL" ]; then
      for d in $(backlight_devices); do
        # if-style, NOT `[ ... ] && DST_BL=... && break`: when the last device
        # examined IS the source, that && list ends the function with status 1,
        # and under `set -e` the caller dies before it can print its diagnostic.
        if [ "$d" != "$SRC_BL" ]; then DST_BL="$d"; break; fi
      done
    fi
  fi
  return 0
}

cmd_sync_backlight() {
  guess_backlights "${1:-}" "${2:-}"
  [ -n "${DST_BL:-}" ] || { log "only one backlight device ($(backlight_devices | tr '\n' ' ')) — nothing to sync"; return 1; }
  local pct
  pct="$(backlight_pct_num "$SRC_BL")" || { log "cannot read $SRC_BL"; return 1; }
  sudo -n "$HELPER" backlight "$DST_BL" "$pct" \
    || { log "helper call failed — is the sudoers rule installed? (sudo ./install.sh --system)"; return 1; }
  log "synced $SRC_BL ($pct%) -> $DST_BL"
}

cmd_watch_backlight() {
  guess_backlights "${1:-}" "${2:-}"
  [ -n "${DST_BL:-}" ] || { log "second backlight device not found — cannot watch"; return 1; }
  log "watch-backlight started ($SRC_BL -> $DST_BL)"
  trap 'log "watch-backlight stopping"; exit 0' INT TERM
  local file="/sys/class/backlight/$SRC_BL/brightness"
  while :; do
    cmd_sync_backlight "$SRC_BL" "$DST_BL" || true
    if command -v inotifywait >/dev/null 2>&1; then
      # Sleep when the watch can't be established (source device missing or
      # gone): inotifywait returns instantly in that case, and without the
      # sleep this becomes a full-speed loop that floods the journal.
      inotifywait -qq -e modify -t 30 "$file" || sleep 2
    else
      sleep 2
    fi
  done
}

# ── keyboard backlight / battery ─────────────────────────────────────────────

cmd_kb_init() {
  # Send the ASUS init handshake so the keyboard emits Fn/media reports. The
  # keyboard forgets it on re-enumeration, so this is safe to run repeatedly.
  python3 "$LIB/kb_init.py"
}

cmd_watch_fn() {
  # Daemon: re-init the keyboard whenever it (re)connects and turn its 0x5a
  # vendor reports into actions (brightness OSD, panel toggle, kb backlight).
  python3 "$LIB/watch_fn.py"
}

cmd_kb_backlight() {
  local level="${1:-}"
  # --show prints the remembered level (what a dock/undock/resume restores).
  if [ "$level" = "--show" ]; then
    python3 "$LIB/kb_backlight.py" --show
    return $?
  fi
  case "$level" in 0|1|2|3) ;; *) usage ;; esac
  if [ -d "$NATIVE_LED" ]; then
    local max
    max="$(cat "$NATIVE_LED/max_brightness" 2>/dev/null || echo 3)"
    local value=$(( level * max / 3 ))
    # Braces so stderr is silenced BEFORE the file is opened: with
    # `echo ... > "$f" 2>/dev/null` bash applies redirections left to right and
    # reports the failed open on the still-original stderr.
    if { echo "$value" > "$NATIVE_LED/brightness"; } 2>/dev/null; then
      # Remember it on this side too: the cycle and the post-dock restore read
      # that file, and they must not diverge just because the kernel gained a
      # native LED and this branch started winning.
      python3 "$LIB/kb_backlight.py" --record "$level" >/dev/null 2>&1 || true
      log "kb-backlight $level via NATIVE LED"
      return 0
    fi
    log "native LED present but not writable — falling back to HID (udev rule missing?)"
  fi
  python3 "$LIB/kb_backlight.py" "$level"
}

cmd_bat_limit() {
  local pct="${1:-}"
  if [ -z "$pct" ]; then
    pct="$(conf_get BATTERY_LIMIT)"
    if [ -z "$pct" ]; then
      log "no BATTERY_LIMIT in $(conf_path) — nothing to apply (set one with: duo config set BATTERY_LIMIT 80)"
      return 0
    fi
  fi
  if ! [[ "$pct" =~ ^[0-9]+$ ]] || [ "$pct" -lt 20 ] || [ "$pct" -gt 100 ]; then
    usage
  fi
  local f applied=0
  for f in /sys/class/power_supply/BAT*/charge_control_end_threshold; do
    [ -e "$f" ] || continue
    # Braces: silence stderr before the open is attempted (see cmd_kb_backlight).
    # Unprivileged runs fall back to the helper below and must stay quiet.
    if { echo "$pct" > "$f"; } 2>/dev/null; then
      applied=1
    fi
  done
  if [ "$applied" = 0 ]; then
    sudo -n "$HELPER" batlimit "$pct" \
      || { log "cannot set battery limit (node missing or helper not installed — sudo ./install.sh --system)"; return 1; }
  fi
  log "battery charge limit set to $pct% (resets on reboot — the bat-limit feature re-applies it at login)"
}

# ── tablet mapping / rotation / fn-probe ─────────────────────────────────────

cmd_set_tablet_mapping() {
  command -v dconf >/dev/null 2>&1 || { log "dconf not found — GNOME session required"; return 1; }
  # Ask Mutter which vendor/product/serial each panel reports, then pin each
  # ELAN digitizer to its panel (GNOME 46+ honors these keys; V7).
  "$PYGI" - "$LIB/displayctl.py" <<'PYEOF'
import json, subprocess, sys
state = json.loads(subprocess.check_output(
    [sys.executable, sys.argv[1], "state", "--json"], text=True))
mons = state["monitors"]
pairs = [("04f3:4259", "eDP-1"), ("04f3:42ec", "eDP-2")]
for digitizer, connector in pairs:
    mon = mons.get(connector)
    if not mon:
        print(f"set-tablet-mapping: {connector} not present — skipping {digitizer}")
        continue
    value = json.dumps([mon["vendor"], mon["product"], mon["serial"]]).replace('"', "'")
    key = f"/org/gnome/desktop/peripherals/touchscreens/{digitizer}/output"
    subprocess.run(["dconf", "write", key, value], check=True)
    print(f"set-tablet-mapping: {digitizer} -> {connector} {value}")
PYEOF
  log "tablet mapping written (VERIFY-ON-HW: docs/PLAN.md phase P)"
}

cmd_watch_rotation() {
  command -v monitor-sensor >/dev/null 2>&1 || { log "monitor-sensor missing (iio-sensor-proxy) — sudo ./install.sh --system"; return 1; }
  log "watch-rotation started (EXPERIMENTAL — logs orientation, applies no changes yet)"
  trap 'log "watch-rotation stopping"; exit 0' INT TERM
  monitor-sensor --accel 2>/dev/null | while read -r line; do
    case "$line" in
      *"orientation changed"*) log "rotation event: $line" ;;
    esac
  done
}

cmd_fn_probe() {
  # The Duo media/Fn keys are ASUS vendor usages hid-generic drops (V8), so they
  # never reach the input layer — capture the RAW hidraw reports instead.
  python3 "$LIB/fn_probe.py" | tee /tmp/zenduo-fn-probe.log
}

cmd_fn_map() {
  python3 "$LIB/fn_map.py" "$@"
}

cmd_watch_input() {
  # Decode key events from the keyboard + Asus WMI hotkeys evdev nodes. Many
  # Fn+Fx media keys arrive via ACPI (asus-nb-wmi) as input events, not hidraw;
  # this shows them. Reading evdev needs root.
  if [ "$(id -u)" != 0 ]; then
    log "watch-input needs root to read /dev/input/event* — re-run:"
    log "  sudo $(readlink -f "${BASH_SOURCE[0]}") watch-input"
    return 1
  fi
  python3 "$LIB/watch_input.py"
}

cmd_status() {
  echo "panels:"
  local p
  for p in "$TOP_PANEL" "$BOTTOM_PANEL"; do
    printf '  %-8s status=%s enabled=%s\n' "$p" "$(panel_status "$p")" "$(panel_enabled "$p")"
  done
  if kb_attached; then echo "keyboard: attached (USB $KBD_VID:$KBD_PID)"; else echo "keyboard: detached (or BT)"; fi
  local ov
  if [ "$ZENDUO_DOCK_POLICY" != 1 ]; then
    echo "dock policy: OFF in $(conf_path) (DOCK_POLICY=$ZENDUO_DOCK_POLICY)"
  elif ov="$(override_active)" && [ -n "$ov" ]; then
    echo "dock policy: PAUSED by a manual layout ($ov) — 'duo apply-displays' resumes it"
  else
    echo "dock policy: active (bottom panel off while docked, on when undocked)"
  fi
  if [ -d "$NATIVE_LED" ]; then echo "kb-backlight: native LED available"; else echo "kb-backlight: HID fallback path"; fi
  echo "kb-backlight level: $(python3 "$LIB/kb_backlight.py" --show 2>/dev/null || echo '?') (restored on dock/undock/resume)"
  local d
  for d in $(backlight_devices); do
    echo "backlight: $d = $(backlight_pct "$d" || echo '?')"
  done
  local f
  for f in /sys/class/power_supply/BAT*/charge_control_end_threshold; do
    [ -e "$f" ] && echo "battery limit: $(cat "$f")% (configured: $(conf_get BATTERY_LIMIT || true))"
  done
  true
}

# ── features / config ────────────────────────────────────────────────────────

feature_desc() {
  case "$1" in
    watch-displays) echo "bottom panel off while the keyboard is docked, back on when it comes off" ;;
    watch-fn)       echo "keyboard hotkey mode + brightness/second-screen/kb-backlight keys" ;;
    watch-backlight) echo "keep the bottom panel backlight synced to the top (off by default)" ;;
    watch-rotation) echo "log accelerometer orientation (EXPERIMENTAL)" ;;
    bat-limit)      echo "re-apply BATTERY_LIMIT from the config at login" ;;
    speaker-dsp)    echo "EasyEffects voicing chain for the built-in speakers" ;;
    psr-fix)        echo "i915.enable_psr=0 on the kernel command line (OLED flicker)" ;;
    palm-rejection) echo "libinput quirk so disable-while-typing covers the detachable touchpad" ;;
    amp-check)      echo "notify when the CS35L41 speaker amps fail to power up" ;;
    *) echo "" ;;
  esac
}

cmd_features() {
  printf '%-16s %-32s %s\n' FEATURE STATE WHAT
  local f
  for f in $USER_FEATURES; do
    printf '%-16s %-32s %s\n' "$f" "$(unit_state "$f")$(unit_is_hm_managed "$f" && echo ' [hm]')" "$(feature_desc "$f")"
  done
  local dsp="not installed"
  if python3 "$LIB/speaker_dsp.py" status 2>/dev/null | grep -q 'db seeded (EasyEffects 8): yes'; then dsp="installed"; fi
  printf '%-16s %-32s %s\n' speaker-dsp "$dsp" "$(feature_desc speaker-dsp)"
  echo
  echo "system features (root; change with: sudo ./install.sh --system --<flag> / --no-<flag>)"
  printf '%-16s %-32s %s\n' psr-fix "$(grep -q 'i915.enable_psr=0' /proc/cmdline 2>/dev/null && echo active || echo inactive)" "$(feature_desc psr-fix)"
  printf '%-16s %-32s %s\n' palm-rejection "$([ -e /etc/libinput/local-overrides.quirks ] && echo installed || echo absent)" "$(feature_desc palm-rejection)"
  printf '%-16s %-32s %s\n' amp-check "$(systemctl is-enabled duo-cs35l41-check.service 2>/dev/null || echo absent)" "$(feature_desc amp-check)"
  echo
  echo "[hm] = unit generated by home-manager; 'duo enable/disable' lasts until the next switch."
}

cmd_enable() {
  local f="${1:-}"
  [ -n "$f" ] || usage
  case " $USER_FEATURES " in
    *" $f "*)
      have_user_systemd || { log "no user systemd session"; return 1; }
      systemctl --user cat "duo-$f.service" >/dev/null 2>&1 || { log "unit duo-$f is not installed — run ./install.sh --user"; return 1; }
      unit_is_hm_managed "$f" && log "note: duo-$f is generated by home-manager; set zenduo.$f there to make this stick"
      systemctl --user enable --now "duo-$f.service"
      log "enabled duo-$f"
      ;;
    *)
      case "$f" in
        speaker-dsp) python3 "$LIB/speaker_dsp.py" install ;;
        psr-fix|palm-rejection|amp-check) log "system feature — run: sudo ./install.sh --system --$f" ;;
        *) log "unknown feature '$f' (see: duo features)"; return 64 ;;
      esac
      ;;
  esac
}

cmd_disable() {
  local f="${1:-}"
  [ -n "$f" ] || usage
  case " $USER_FEATURES " in
    *" $f "*)
      have_user_systemd || { log "no user systemd session"; return 1; }
      unit_is_hm_managed "$f" && log "note: duo-$f is generated by home-manager; set zenduo.$f = false there to make this stick"
      systemctl --user disable --now "duo-$f.service" 2>/dev/null || true
      log "disabled duo-$f"
      ;;
    *)
      case "$f" in
        speaker-dsp) python3 "$LIB/speaker_dsp.py" uninstall ;;
        psr-fix|palm-rejection|amp-check) log "system feature — run: sudo ./install.sh --system --no-$f" ;;
        *) log "unknown feature '$f' (see: duo features)"; return 64 ;;
      esac
      ;;
  esac
}

cmd_config() {
  case "${1:-show}" in
    show)
      echo "# $(conf_path) ($([ -r "$(conf_path)" ] && echo present || echo 'absent — built-in defaults'))"
      local key
      for key in $(conf_defaults | cut -d= -f1); do
        printf '%s=%s\n' "$key" "$(conf_get "$key")"
      done
      ;;
    get) [ -n "${2:-}" ] || usage; conf_get "$2" ;;
    set) [ -n "${2:-}" ] && [ -n "${3:-}" ] || usage; conf_set "$2" "$3" && log "$2=$3 written to $(conf_path) (restart the daemon that reads it)" ;;
    path) conf_path ;;
    *) usage ;;
  esac
}

cmd_speaker_dsp() {
  [ -n "${1:-}" ] || usage
  python3 "$LIB/speaker_dsp.py" "$@"
}

cmd_report() {
  echo "== zenduo report — $(date -u +%FT%TZ) =="
  echo
  cmd_doctor || true
  echo
  echo "== status =="
  cmd_status || true
  echo
  echo "== features =="
  cmd_features || true
  echo
  echo "== config =="
  cmd_config show || true
  echo
  echo "== zenduo journal (last 100) =="
  journalctl --user -t "$TAG" -n 100 --no-pager 2>/dev/null || echo "(journal unavailable)"
  echo
  echo "== daemon journals (last 40 each) =="
  local f
  for f in $USER_FEATURES; do
    echo "-- duo-$f"
    journalctl --user -u "duo-$f.service" -n 40 --no-pager 2>/dev/null || true
  done
  echo
  echo "== kernel: i915 / asus / sof / cs35l41 (last 40) =="
  { dmesg 2>/dev/null || journalctl -k -b --no-pager 2>/dev/null; } | grep -iE 'i915|asus|sof|cs35l41' | tail -n 40 || true
  echo
  echo "== hid / input =="
  for u in /sys/class/hidraw/hidraw*/device/uevent; do
    [ -r "$u" ] && { echo "-- $u"; grep -E 'HID_ID|HID_NAME' "$u"; }
  done 2>/dev/null || true
  echo "== end of report =="
}

# ── dispatch ─────────────────────────────────────────────────────────────────

cmd="${1:-}"; shift || true
case "$cmd" in
  doctor)             cmd_doctor "$@" ;;
  status)             cmd_status "$@" ;;
  features)           cmd_features "$@" ;;
  enable)             cmd_enable "$@" ;;
  disable)            cmd_disable "$@" ;;
  config)             cmd_config "$@" ;;
  top|bottom|both|toggle) "$PYGI" "$LIB/displayctl.py" "$cmd" "$@" ;;
  watch-displays)     exec "$PYGI" "$LIB/watch_displays.py" "$@" ;;
  apply-displays)     exec "$PYGI" "$LIB/watch_displays.py" --once "$@" ;;
  sync-backlight)     cmd_sync_backlight "$@" ;;
  watch-backlight)    cmd_watch_backlight "$@" ;;
  kb-init)            cmd_kb_init "$@" ;;
  watch-fn)           cmd_watch_fn "$@" ;;
  kb-backlight)       cmd_kb_backlight "$@" ;;
  bat-limit)          cmd_bat_limit "$@" ;;
  speaker-dsp)        cmd_speaker_dsp "$@" ;;
  set-tablet-mapping) cmd_set_tablet_mapping "$@" ;;
  watch-rotation)     cmd_watch_rotation "$@" ;;
  fn-probe)           cmd_fn_probe "$@" ;;
  fn-map)             cmd_fn_map "$@" ;;
  watch-input)        cmd_watch_input "$@" ;;
  report)             cmd_report "$@" ;;
  log)                journalctl --user -t "$TAG" -f ;;
  version|--version)  cat "$DUO_ROOT/VERSION" 2>/dev/null || echo dev ;;
  help|-h|--help|*)   usage ;;
esac
