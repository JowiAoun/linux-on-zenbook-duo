# zenduo — installed into ~/.config/systemd/user/ by ./install.sh (the
# home-manager module generates its own copy). For a manual install: copy it
# there, fix ExecStart if `duo` lives elsewhere, then
#   systemctl --user daemon-reload && systemctl --user enable --now duo-watch-displays
[Unit]
Description=zenduo: keep the panel layout matching the keyboard dock state
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/duo watch-displays
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
