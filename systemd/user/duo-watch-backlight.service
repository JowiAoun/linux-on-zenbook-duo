# zenduo — see duo-watch-displays.service for how these units are installed.
# Off by default: the brightness keys already mirror the level onto the bottom
# panel through duo-watch-fn. Enable this if you change brightness some other
# way (a slider, an ambient-light daemon) and want the panels to track.
[Unit]
Description=zenduo: sync bottom panel backlight to the top panel
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# One identifier for every zenduo process, so `duo log` (journalctl -t zenduo)
# shows the daemons' output and not only what bin/duo sent through logger.
SyslogIdentifier=zenduo
Type=simple
ExecStart=/usr/local/bin/duo watch-backlight
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
