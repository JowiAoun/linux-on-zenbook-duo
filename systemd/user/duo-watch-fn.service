# zenduo — see duo-watch-displays.service for how these units are installed.
[Unit]
Description=zenduo: init keyboard hotkey mode + act on media keys
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/duo watch-fn
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
