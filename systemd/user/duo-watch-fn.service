# zenduo — see duo-watch-displays.service for how these units are installed.
[Unit]
Description=zenduo: init keyboard hotkey mode + act on media keys
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# One identifier for every zenduo process, so `duo log` (journalctl -t zenduo)
# shows the daemons' output and not only what bin/duo-cli sent through logger.
SyslogIdentifier=zenduo
Type=simple
ExecStart=/usr/local/bin/duo-cli watch-fn
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
