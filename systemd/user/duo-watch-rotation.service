# zenduo — see duo-watch-displays.service for how these units are installed.
# EXPERIMENTAL: currently logs orientation events without acting on them.
[Unit]
Description=zenduo: follow accelerometer orientation (experimental)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# One identifier for every zenduo process, so `duo log` (journalctl -t zenduo)
# shows the daemons' output and not only what bin/duo sent through logger.
SyslogIdentifier=zenduo
Type=simple
ExecStart=/usr/local/bin/duo watch-rotation
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
